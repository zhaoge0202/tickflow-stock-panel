# ===== TickFlow =====
# 留空或不填则启用 Free 试用模式(TickFlow.free()),仅能拿历史日 K 单股数据
TICKFLOW_API_KEY=

# ===== tdx-api sidecar(可选) =====
# Docker 部署时 tdx-api sidecar 默认只绑定服务器本机 127.0.0.1, 避免公网裸露。
# 代理池不要写在根 .env,
# 请写入 docs/zhihu/tdx-api/.env 中的 TDX_SOCKS5_PROXY/TDX_SOCKS5_PROXIES。
TDX_API_PORT=8080
# Dev 模式手动启动 tdx-api sidecar 时, 后端用这个地址连接。
TDX_API_BASE_URL=http://127.0.0.1:8080

# ===== MySQL(逐笔成交持久化) =====
# Docker compose 会启动内置 MySQL, app 通过 Docker 内网访问, 不暴露 3306 到公网。
MYSQL_ROOT_PASSWORD=请改成强随机密码
MYSQL_DATABASE=tickflow_stock_panel
MYSQL_USER=tickflow
MYSQL_PASSWORD=请改成强随机密码

# ===== TDX 逐笔成交持久化(可选) =====
# 开启后, 后台会把用户查看/手动触发的单票逐笔成交异步写入 MySQL。
# Docker 部署时无需改 URL: docker-compose.yml 会覆盖为 mysql 容器内网地址。
TRADE_TICKS_PERSIST_ENABLED=false
TRADE_TICKS_MYSQL_URL=mysql+pymysql://tickflow:请改成强随机密码@mysql:3306/tickflow_stock_panel?charset=utf8mb4
TRADE_TICKS_PERSIST_INTERVAL_SECONDS=30
TRADE_TICKS_PERSIST_TIMEOUT_SECONDS=120

# ===== MySQL 最新行情快照热缓存(可选) =====
# 复用 TRADE_TICKS_MYSQL_URL；数据库异常会自动降级到内存环和 Parquet。
QUOTE_SNAPSHOT_MYSQL_ENABLED=true

# ===== AI(可选,留空跳过 AI 功能) =====
AI_PROVIDER=openai_compat          # openai_compat | ollama
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_DAILY_TOKEN_BUDGET=500000

# ===== Server =====
HOST=0.0.0.0
# Docker 部署时 compose 会把宿主端口绑定到 127.0.0.1:${PORT}, 建议由 Caddy 反代公网访问。
PORT=3018
LOG_LEVEL=INFO

# ===== Auth =====
# 首次启动时预置访问密码(可选)。公网服务器部署时填入,免去 SSH 端口转发设密码。
# 仅在尚未设置密码时生效(一次性初始化);设过后改密码请用页面 UI, 此处不再读取。
# 建议至少 6 位。.env 文件权限保持 600 且不要提交到 Git。
AUTH_PASSWORD=''

# Optional backend dependency extras for Docker and ./dev.sh / .\dev.ps1.
# Set to legacy-cpu on older CPUs without AVX2/FMA support.
# Combine with backtest as: legacy-cpu backtest
BACKEND_EXTRAS=

# ===== Data =====
DATA_DIR=./data
